# ── FairyReport 云端服务环境变量配置样例 ──
# 部署时请复制为 .env 文件并填入实际 API Key:
# cp .env.example .env

# 大模型 API 密钥（必填，推荐使用 DeepSeek API）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 可选：自定义模型 API 接入地址（默认官方 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：默认模型名称（默认 deepseek-chat，或 deepseek-reasoner）
# DEFAULT_MODEL=deepseek-chat

# 服务端配置（Docker 部署保持默认即可）
HOST=0.0.0.0
PORT=8000
ENGINE_DATA_DIR=/app/data
HF_ENDPOINT=https://hf-mirror.com
