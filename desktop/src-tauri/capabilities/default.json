{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认能力：核心 + shell spawn/kill（python 子进程白名单）+ http fetch（云服务器 + 引擎健康）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-confirm",
    "dialog:allow-ask",
    "dialog:allow-message",
    "shell:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "python-uvicorn", "cmd": "python", "args": true },
        { "name": "binaries/fairyreport-engine", "sidecar": true, "args": true }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/fairyreport-engine", "sidecar": true, "args": true }
      ]
    },
    "shell:allow-kill",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*/*" },
        { "url": "https://*/*" },
        { "url": "http://*:*/*" },
        { "url": "https://*:*/*" },
        { "url": "http://127.0.0.1:*/*" },
        { "url": "http://localhost:*/*" }
      ]
    }
  ]
}
