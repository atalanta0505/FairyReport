{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FairyReport",
  "version": "1.0.0",
  "identifier": "com.fairyreport.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FairyReport",
        "width": 1100,
        "height": 750,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "shell": {
      "scope": [
        {
          "name": "python-uvicorn",
          "command": "python",
          "args": true
        }
      ]
    }
  }
}
